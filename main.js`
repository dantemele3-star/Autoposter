const { app, BrowserWindow, ipcMain } = require('electron');
const puppeteer = require('puppeteer');
const path = require('path');
const fs = require('fs');
const os = require('os');

async function processDrafts(config) {
    const sessionPath = path.join(os.homedir(), 'AppData', 'Local', 'Gameflip_Ghost_Session');
    
    const browser = await puppeteer.launch({ 
        headless: false, 
        executablePath: 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe', 
        userDataDir: sessionPath, 
        args: [
            '--no-sandbox', 
            '--disable-setuid-sandbox',
            '--disable-blink-features=AutomationControlled',
            '--start-maximized'
        ] 
    });
    
    const pages = await browser.pages();
    const page = pages.length > 0 ? pages[0] : await browser.newPage();

    try {
        console.log("\n--- 👻 GHOST SESSION STARTED ---");
        console.log("Navigating to Gameflip Drafts...");
        await page.goto('https://gameflip.com/listings/draft', { waitUntil: 'networkidle2' });

        if (page.url().includes('login')) {
            console.log("⚠️ Not logged in. Please log in manually...");
            await page.waitForFunction(() => window.location.href.includes('/listings/draft'), { timeout: 600000 });
            console.log("✅ Login detected. Continuing...");
        }

        console.log("Scanning for drafts...");
        await new Promise(r => setTimeout(r, 5000));

        const draftElements = await page.$$('.tool-duplicate'); 
        
        if (draftElements.length === 0) {
            throw new Error("No drafts found. Please ensure you are on the Drafts page.");
        }

        console.log(`🎯 Found ${draftElements.length} drafts to process.`);

        let indices = Array.from({length: draftElements.length}, (_, i) => i);
        if (config.randomize) {
            console.log("🎲 Randomizing order...");
            indices = indices.sort(() => Math.random() - 0.5);
        }

        let postedCount = 0;

        for (const index of indices) {
            console.log(`\n📦 Processing Item ${index + 1}/${draftElements.length}...`);
            
            try {
                await page.goto('https://gameflip.com/listings/draft', { waitUntil: 'networkidle2' });
                await new Promise(r => setTimeout(r, 3000));
                
                const currentButtons = await page.$$('.tool-duplicate');
                if (currentButtons.length <= index) {
                    console.log(" ⚠️ Item no longer in drafts, skipping.");
                    continue;
                }
                const copyButton = currentButtons[index];

                await copyButton.click();
                console.log(" 🖱️ Clicked 'Create a copy in Draft'...");

                await page.waitForNavigation({ waitUntil: 'networkidle2' });
                await new Promise(r => setTimeout(r, 5000));

                // --- FIX: AGGRESSIVE SCROLLING AND SEARCHING ---
                console.log("Attempting to find 'Done' button...");
                
                // Try to find the button via evaluation
                const doneButtonHandle = await page.evaluateHandle(() => {
                    const buttons = Array.from(document.querySelectorAll('button'));
                    const btn = buttons.find(b => b.innerText.includes('Done'));
                    if (btn) {
                        btn.scrollIntoView({ behavior: 'auto', block: 'center' });
                    }
                    return btn;
                });

                if (!doneButtonHandle) {
                    console.log("Done button not found via text, trying scroll-down approach...");
                    await page.evaluate(() => window.scrollTo(0, document.body.scrollHeight));
                    await new Promise(r => setTimeout(r, 2000));
                }

                // Click the "Done" button (re-finding it in case of page shifts)
                const finalDoneBtn = await page.evaluateHandle(() => {
                    const buttons = Array.from(document.querySelectorAll('button'));
                    return buttons.find(b => b.innerText.includes('Done'));
                });

                if (!finalDoneBtn) throw new Error("Could not find 'Done' button after scrolling.");
                await finalDoneBtn.click();
                console.log(" 🖱️ Clicked 'Done'...");

                await new Promise(r => setTimeout(r, 4000));

                // Find and click "List Item"
                const listButton = await page.evaluateHandle(() => {
                    const buttons = Array.from(document.querySelectorAll('button'));
                    const btn = buttons.find(b => b.innerText.includes('List Item'));
                    if (btn) btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return btn;
                });

                if (!listButton) throw new Error("Could not find 'List Item' button.");
                await listButton.click();
                console.log(" ✅ Clicked 'List Item' - SUCCESS!");

                await page.waitForNavigation({ waitUntil: 'networkidle2' });
                postedCount++;
                console.log(` ✨ Item ${index + 1} is now LIVE.`);

            } catch (itemErr) {
                console.error(` ❌ Item ${index + 1} failed: ${itemErr.message}`);
            }
        }

        console.log("\n--- 🏁 ALL ITEMS PROCESSED ---");
        console.log(`Total successfully posted: ${postedCount}`);
        return { success: true, postedCount };
    } catch (err) {
        console.error("❌ CRITICAL ERROR:", err.message);
        throw new Error(`Draft-Poster Error: ${err.message}`);
    } finally {
        await new Promise(r => setTimeout(r, 5000));
        await browser.close();
        console.log("--- 👻 GHOST SESSION CLOSED ---");
    }
}

ipcMain.handle('process-drafts', async (event, config) => {
    try {
        const result = await processDrafts(config);
        return result;
    } catch (err) {
        return { success: false, error: err.message };
    }
});

app.whenReady().then(() => {
    const win = new BrowserWindow({
        width: 800,
        height: 700,
        webPreferences: { nodeIntegration: true, contextIsolation: false }
    });
    win.loadFile('index.html');
});